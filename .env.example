# clark configuration — copy this file to `.env` and fill in your values.
# Everything is optional except OLLAMA_MODEL.

# --- Required ---
# Your Ollama server (host running the model). Inside Docker, use
# http://host.docker.internal:11434 to reach the host's Ollama.
OLLAMA_URL=http://localhost:11434
# Model tag as shown by `ollama list` on the server.
OLLAMA_MODEL=

# --- Optional ---
# SQLite database path (used for settings, WhatsApp session, and history).
CLARK_DB=mystore.db

# Enable the web_search tool. Get a free key at https://tavily.com
TAVILY_API_KEY=

# Disable desktop notifications (useful in Docker/headless servers).
CLARK_NO_NOTIFY=0

# --- Persona (optional) ---
# These only shape the butler prompt. Leave them empty for generic defaults.
# The name clark addresses the person you serve.
MASTER_NAME=the Master
# Short name used as "The <PROTOCOL_NAME> Protocol".
PROTOCOL_NAME=Butler
# The household name, e.g. "The Rosewood Manor".
PALACE_NAME=Palace
# The exact phrase a VIP must send to alert you urgently.
BYPASS_PHRASE=get him to me
# People clark treats as the dearest of the Master. Format:
#   Name|Relation;Name|Relation
# (relation is optional: "Name|Relationship;Name|Relationship;Name|Relationship")
INNER_CIRCLE=

# --- iMessage bridge (optional) ---
# Turns on the bridge-facing HTTP API (served only inside the Docker network).
# NPM must proxy https://clark.<your-domain>/ to http://clark:8090.
IMESSAGE_ENABLED=0
# Shared secret the macOS bridge sends in the X-Clark-Bridge-Token header.
# MUST match the bridge's IMESSAGE_BRIDGE_TOKEN. Leave empty only if you accept
# an unauthenticated bridge API.
IMESSAGE_BRIDGE_TOKEN=
# Your own iMessage handle (e.g. +6281234567890), used for self-chat bootstrap.
IMESSAGE_SELF_HANDLE=

# --- Web console (v4) ---
# Serve the bento dashboard + chat on :8090. WEB_TOKEN is REQUIRED when
# enabled — the server refuses to start without it. Generate one:
#   openssl rand -hex 32
WEB_ENABLED=1
WEB_TOKEN=
# Shared secret for monitoring alert webhooks (Netdata, Uptime Kuma, bootwatch).
# Sent in the X-Clark-Alert-Token header to POST /web/api/notify. Generate with:
#   openssl rand -hex 32
ALERT_TOKEN=
# Alert delivery mode: "voice" (speak alerts aloud + WhatsApp/iMessage/web) or
# "silent" (WhatsApp/iMessage/web + FaceTime call + macOS banner, no speech).
# Toggle from the console too. Default: voice.
ALERT_MODE=voice
# macOS bridge action endpoint (FaceTime call + native banner for silent-mode
# alerts). The bridge listens here (IMESSAGE_ACTION_LISTEN on the Mac).
MAC_ACTION_URL=http://100.94.240.11:8791
MAC_ACTION_TOKEN=
# Speech seam. STT = faster-whisper baked into the image (CPU int8); set
# STT_ENGINE=ollama to use an Ollama whisper model instead (STT_MODEL then
# names it). TTS = Kokoro on the Master's Mac (TTS_REMOTE_URL, near-instant on
# Apple Silicon via MLX) with the server-side Piper daemon (TTS_VOICE) as the
# fallback so clark can still speak when the Mac is asleep or unreachable; set
# TTS_ENGINE=piper to force server-side only.
STT_ENGINE=faster-whisper
STT_MODEL=whisper-turbo
TTS_ENGINE=kokoro-remote
TTS_VOICE=en_US-ryan-high
KOKORO_VOICE=am_michael
# Remote Kokoro server (run scripts/install-kokoro-tts.sh on the Mac).
# TTS_REMOTE_TOKEN must match the token passed to that installer.
TTS_REMOTE_URL=
TTS_REMOTE_TOKEN=
# Piper and faster-whisper script/model paths inside the container
# (override only for local runs).
PIPER_DAEMON=/opt/piper/daemon.py
PIPER_VOICE=/opt/piper/voices/en_US-ryan-high.onnx
WHISPER_SCRIPT=/opt/whisper/run.py
WHISPER_MODEL_DIR=/opt/whisper/model
AFFIRMATIONS_DIR=/opt/affirmations

# Name of the Nginx Proxy Manager Docker network the clark container attaches to.
NPM_NETWORK=npm_default
