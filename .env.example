# clark configuration — copy this file to `.env` and fill in your values.
# Everything is optional except OLLAMA_MODEL.

# --- Required ---
# Your Ollama server (host running the model). Inside Docker, use
# http://host.docker.internal:11434 to reach the host's Ollama.
OLLAMA_URL=http://localhost:11434
# Model tag as shown by `ollama list` on the server.
OLLAMA_MODEL=

# --- Optional ---
# SQLite database path (used for settings, WhatsApp session, and history).
CLARK_DB=mystore.db

# Enable the web_search tool. Get a free key at https://tavily.com
TAVILY_API_KEY=

# Disable desktop notifications (useful in Docker/headless servers).
CLARK_NO_NOTIFY=0

# --- Persona (optional) ---
# These only shape the butler prompt. Leave them empty for generic defaults.
# The name clark addresses the person you serve.
MASTER_NAME=the Master
# Short name used as "The <PROTOCOL_NAME> Protocol".
PROTOCOL_NAME=Butler
# The household name, e.g. "The Rosewood Manor".
PALACE_NAME=Palace
# The exact phrase a VIP must send to alert you urgently.
BYPASS_PHRASE=get him to me
# People clark treats as the dearest of the Master. Format:
#   Name|Relation;Name|Relation
# (relation is optional: "Name|Relationship;Name|Relationship;Name|Relationship")
INNER_CIRCLE=
